import tkinter as tk
from tkinter import messagebox
from kga import (create_database,create_account,login,forgot_password,show_reasons,do_transaction,show_transactions)
current_user = None
# Button Functions
def create_database_gui():
    create_database()
    messagebox.showinfo("Success", "Database and tables created successfully.")
def create_account_gui():
    create_account()
def login_gui():
    global current_user
    username = username_entry.get().strip()
    password = password_entry.get().strip()
    if username == "" or password == "":
        messagebox.showwarning("Warning", "Enter Username and Password")
        return
    user = login(username, password)
    if user:
        current_user = user
        messagebox.showinfo("Success", "Login Successful")
        reasons_btn.config(state="normal")
        transaction_btn.config(state="normal")
        show_transaction_btn.config(state="normal")
    else:
        messagebox.showerror("Error", "Wrong Username or Password")
def forgot_password_gui():
    username = username_entry.get().strip()
    if username == "":
        messagebox.showwarning("Warning", "Enter Username")
        return
    forgot_password(username)
def reasons_gui():
    if current_user:
        show_reasons(current_user)
    else:
        messagebox.showwarning("Warning", "Please Login First")
def transaction_gui():
    if current_user:
        do_transaction(current_user)
    else:
        messagebox.showwarning("Warning", "Please Login First")
def show_transaction_gui():
    if current_user:
        show_transactions(current_user)
    else:
        messagebox.showwarning("Warning", "Please Login First")
# Main Window
root = tk.Tk()
root.title("Household Finance Manager")
root.geometry("800x750")
root.resizable(False, False)
root.configure(bg="#EAF6F6")

title = tk.Label(root,text="Household Finance Management System",font=("Book Antiqua",20,"bold italic"),bg="#EAF6F6",fg="darkblue")
title.pack(pady=15)

tk.Label(root,text="Username",font=("Book Antiqua",13,"bold italic"),bg="#EAF6F6").pack()
username_entry = tk.Entry(root,width=32,font=("Book Antiqua",12,"bold"))
username_entry.pack(pady=4)

tk.Label(root,text="Password",font=("Book Antiqua",13,"bold italic"),bg="#EAF6F6").pack()
password_entry = tk.Entry(root,width=32,show="*",font=("Book Antiqua",12,"bold"))
password_entry.pack(pady=4)

tk.Button(root,text="If First Time Click Here to Create SQL Tables",width=42,height=2,bg="yellow",fg="black",font=("Book Antiqua",11,"bold italic"),command=create_database_gui).pack(pady=6)

tk.Button(root,text="Create Account",width=28,height=2,bg="green",fg="black",font=("Book Antiqua",11,"bold italic"),command=create_account_gui).pack(pady=6)

tk.Button(root,text="Login",width=28,height=2,bg="blue",fg="white",font=("Book Antiqua",11,"bold italic"),command=login_gui).pack(pady=6)

tk.Button(root,text="Forgot Password",width=28,height=2,bg="orange",fg="black",font=("Book Antiqua",11,"bold italic"),command=forgot_password_gui).pack(pady=6)

reasons_btn = tk.Button(root,text="Show Expense Reasons",width=28,height=2,bg="lightgreen",fg="black",font=("Book Antiqua",11,"bold italic"),state="disabled",command=reasons_gui)
reasons_btn.pack(pady=6)
transaction_btn = tk.Button(root,text="Do Transactions",width=28,height=2,bg="cyan",fg="black",font=("Book Antiqua",11,"bold italic"),state="disabled",command=transaction_gui)
transaction_btn.pack(pady=6)

show_transaction_btn = tk.Button(root,text="Show Transactions",width=28,height=2,bg="gold",fg="black",font=("Book Antiqua",11,"bold italic"),state="disabled",command=show_transaction_gui)
show_transaction_btn.pack(pady=6)

tk.Button(root,text="Exit",width=28,height=2,bg="red",fg="black",font=("Book Antiqua",11,"bold italic"),command=root.destroy).pack(pady=15)

root.mainloop()
