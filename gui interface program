import tkinter as tk
from tkinter import messagebox
from household_finance_system import (create_account,connection,login,forgot_password,show_reasons)
current_user = None

def create_account_gui():
    create_account()
def login_gui():
    global current_user
    user = login()
    if user:
        current_user = user
        messagebox.showinfo("Success", "Login Successful")
    else:
        messagebox.showerror("Error", "Login Failed")
def forgot_password_gui():
    username = username_entry.get()

    if username == "":
        messagebox.showwarning("Warning", "Enter Username")
        return
    forgot_password(username)
def reasons_gui():
    if current_user:
        show_reasons(current_user)
    else:
        messagebox.showwarning("Warning", "Please Login First")

root = tk.Tk()
root.title("Household Finance Manager")
root.geometry("500x500")
root.resizable(False, False)
root.configure(bg="#EAF6F6")

title = tk.Label(root,text="Household Finance Management System",font=("Arial", 18, "bold"),bg="#EAF6F6",fg="darkblue")
title.pack(pady=20)
tk.Label(root,text="Username",font=("Arial", 12),bg="#EAF6F6").pack()
username_entry = tk.Entry(root, width=30)
username_entry.pack(pady=5)
tk.Button(root,text="Create Account",width=25,bg="green",fg="white",command=create_account_gui).pack(pady=8)
tk.Button(root,text="Login",width=25,bg="blue",fg="white",command=login_gui).pack(pady=8)
tk.Button(root,text="Forgot Password",width=25,bg="orange",command=forgot_password_gui).pack(pady=8)
tk.Button(root,text="Show Expense Reasons",width=25,command=reasons_gui).pack(pady=8)
tk.Button(root,text="Exit",width=25,bg="red",fg="white",command=root.destroy).pack(pady=20)
root.mainloop()
