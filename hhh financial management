import mysql.connector
def create_database():
    con = mysql.connector.connect(host="localhost",user="root",password="12345678")
    cur = con.cursor()
    cur.execute("CREATE DATABASE IF NOT EXISTS household_finance")
    cur.execute("USE household_finance")
    cur.execute("CREATE TABLE IF NOT EXISTS users(username VARCHAR(30) PRIMARY KEY,password VARCHAR(50),financial_limit FLOAT,working_as VARCHAR(50),fav_movie VARCHAR(50),movie_hint VARCHAR(100),reason1 VARCHAR(50),reason2 VARCHAR(50),reason3 VARCHAR(50),reason4 VARCHAR(50),reason5 VARCHAR(50))")
    cur.execute("CREATE TABLE IF NOT EXISTS transactions(id INT AUTO_INCREMENT PRIMARY KEY,username VARCHAR(30),reason VARCHAR(50),amount FLOAT,balance_left FLOAT,date1 DATE,time1 TIME)")
    con.commit()
    con.close()
    print("Database and tables created successfully.")
def do_transaction(username):
    con = connection()
    cur = con.cursor()
    cur.execute("SELECT financial_limit FROM users WHERE username=%s",(username,) )
    financial_limit = cur.fetchone()[0]
    cur.execute("SELECT reason1, reason2, reason3, reason4, reason5 FROM users WHERE username=%s",(username,))
    reasons = cur.fetchone()
    print("\nYour Expense Reasons")
    print("--------------------")
    for i, reason in enumerate(reasons, start=1):
        print(f"{i}. {reason}")
    choice = int(input("Choose Reason (1-5): "))
    amount = float(input("Enter Debit Amount : "))
    reason = reasons[choice - 1]
    cur.execute("SELECT IFNULL(SUM(amount),0) FROM transactions WHERE username=%s",(username,))
    total_spent = cur.fetchone()[0]
    balance_left = financial_limit - (total_spent + amount)
    cur.execute("""INSERT INTO transactions (username, reason, amount, balance_left) VALUES (%s,%s,%s,%s)""",(username, reason, amount, balance_left))
    con.commit()
    print("\nTransaction Added Successfully")
    print("Remaining Balance :", balance_left)
    con.close()
def show_transactions(username):
    con = connection()
    cur = con.cursor()
    cur.execute("SELECT * FROM transactions WHERE username=%s",(username,))
    rows = cur.fetchall()
    print("\n******** TRANSACTIONS ********")
    print("-" * 70)
    print("ID\tReason\t\tAmount\tBalance Left")
    print("-" * 70)
    if not rows:
        print("No transactions found.")
    else:
        for row in rows:
            print(f"{row[0]}\t{row[2]}\t\t{row[3]}\t{row[4]}")
