# Password checking function
def password_validation(password):
    if password.isdigit() and password.isalpha:
        return True
    return False
def check_username(username):
    con = connection()
    cur = con.cursor()
    cur.execute("SELECT username FROM users WHERE username=%s",(username,))
    result = cur.fetchone()
    con.close()
    if result:
        return True
    return False
